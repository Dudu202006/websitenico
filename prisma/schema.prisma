generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MAGASIN
  PRODUCTION
}

enum StatutCommande {
  EN_ATTENTE
  EN_PREPARATION
  EXPEDIEE
  LIVREE
  ANNULEE
}

enum TypeEvenement {
  CONGE
  RDV
  PRODUCTION
  LIVRAISON
  AUTRE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nom       String
  role      Role
  magasinId String?
  magasin   Magasin? @relation(fields: [magasinId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Magasin {
  id          String              @id @default(cuid())
  nom         String
  adresse     String
  telephone   String?
  actif       Boolean             @default(true)
  users       User[]
  inventaires InventaireMagasin[]
  commandes   Commande[]
  recettePartages RecetteMagasin[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Produit {
  id            String              @id @default(cuid())
  nom           String
  description   String?
  categorie     String
  prix          Float
  unite         String              @default("unité")
  actif         Boolean             @default(true)
  inventaires   InventaireMagasin[]
  lignesCommande LigneCommande[]
  stockProduction StockProductionProduit[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model InventaireMagasin {
  id          String   @id @default(cuid())
  magasinId   String
  produitId   String
  quantite    Float    @default(0)
  seuilAlerte Float    @default(5)
  magasin     Magasin  @relation(fields: [magasinId], references: [id], onDelete: Cascade)
  produit     Produit  @relation(fields: [produitId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt

  @@unique([magasinId, produitId])
}

model Commande {
  id        String         @id @default(cuid())
  numero    String         @unique
  magasinId String
  statut    StatutCommande @default(EN_ATTENTE)
  notes     String?
  magasin   Magasin        @relation(fields: [magasinId], references: [id])
  lignes    LigneCommande[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model LigneCommande {
  id         String   @id @default(cuid())
  commandeId String
  produitId  String?
  nomLibre   String?
  quantite   Float
  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produit    Produit? @relation(fields: [produitId], references: [id])

  @@unique([commandeId, produitId])
}

model Marchandise {
  id          String                    @id @default(cuid())
  nom         String
  description String?
  categorie   String
  unite       String                    @default("kg")
  actif       Boolean                   @default(true)
  stock       StockProductionMarchandise?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

model StockProductionProduit {
  id          String  @id @default(cuid())
  produitId   String  @unique
  quantite    Float   @default(0)
  seuilAlerte Float   @default(10)
  produit     Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt
}

model StockProductionMarchandise {
  id            String      @id @default(cuid())
  marchandiseId String      @unique
  quantite      Float       @default(0)
  seuilAlerte   Float       @default(5)
  marchandise   Marchandise @relation(fields: [marchandiseId], references: [id], onDelete: Cascade)
  updatedAt     DateTime    @updatedAt
}

model Recette {
  id           String              @id @default(cuid())
  nom          String
  description  String?
  instructions String?
  allergenes   String[]
  portionsBase Float               @default(1)
  unitePortion String              @default("personnes")
  photoFilename String?
  photoMimeType String?
  ingredients  RecetteIngredient[]
  partages     RecetteMagasin[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model RecetteIngredient {
  id             String  @id @default(cuid())
  recetteId      String
  nom            String
  quantite       String?
  quantiteValeur Float?
  quantiteUnite  String?
  recette        Recette @relation(fields: [recetteId], references: [id], onDelete: Cascade)
}

model RecetteMagasin {
  id        String  @id @default(cuid())
  recetteId String
  magasinId String
  recette   Recette @relation(fields: [recetteId], references: [id], onDelete: Cascade)
  magasin   Magasin @relation(fields: [magasinId], references: [id], onDelete: Cascade)

  @@unique([recetteId, magasinId])
}

model EvenementProduction {
  id          String        @id @default(cuid())
  titre       String
  description String?
  type        TypeEvenement @default(AUTRE)
  couleur     String        @default("#7F8C8D")
  dateDebut   DateTime
  dateFin     DateTime
  jourEntier  Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Photo {
  id          String   @id @default(cuid())
  titre       String
  description String?
  categorie   String   @default("Autre")
  filename    String   @unique
  mimeType    String
  taille      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
